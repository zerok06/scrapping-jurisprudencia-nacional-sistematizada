# ==============================================================================
# CONFIGURACIÓN DEL SCRAPER DE JURISPRUDENCIA
# ==============================================================================

# Intervalo en horas entre ejecuciones automáticas del orquestador
SCRAPING_INTERVAL_HOURS=12.0

# Si se establece en True, el orquestador corre una ronda y se detiene automáticamente
RUN_ONCE=False

# Especialidades de interés separadas por comas (dejar vacío para escanear todas)
# Opciones disponibles: civil, comercial, constitucional, contencioso_adm_laboral, 
# contencioso_adm_previsional, contencioso_administrativo, familia_civil, familia_penal, 
# familia_tutelar, laboral, penal, revision_coactivo
ESPECIALIDADES=civil,penal

# Rango de años de interés separados por comas
ANIOS=2024,2025,2026

# Límite de descargas concurrentes de PDFs (semáforo asíncrono)
DOWNLOAD_CONCURRENCY_LIMIT=5

# ¿Eliminar el PDF después de extraer el texto a Markdown? 
# Recomendado en True para entornos VPS con almacenamiento SSD limitado.
DELETE_PDF_AFTER_PROCESSING=True

# ==============================================================================
# CONFIGURACIÓN DE GOOGLE CLOUD STORAGE (OPCIONAL)
# ==============================================================================
# Nombre del Bucket de GCS para centralizar y respaldar la información.
# Dejar vacío si solo se desea almacenamiento local.
# Nota: La autenticación se realiza mediante WIF (Application Default Credentials).
GCS_BUCKET_NAME=
