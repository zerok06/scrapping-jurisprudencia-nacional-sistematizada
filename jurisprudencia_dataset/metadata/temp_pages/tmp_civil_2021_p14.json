  {
    "uuid": "a5d4f2cf-290c-4f04-ba0b-ebc7bedc439c",
    "nro_expediente": "",
    "tipo_resolucion": "Ejecutoria Suprema",
    "fecha_resolucion": "09/11/2021",
    "sala_suprema": "Sala de Derecho Constitucional y Social Permanente",
    "especialidad": "civil",
    "delito_pretension": "A ingresar",
    "sumilla": "En los procesos de otorgamiento de escritura pública, la actividad jurisdiccional debe comprender el verificar si existe o no la obligación de la parte demandada de otorgar la escritura pública, lo que se ha visto satisfecho desde que la parte demandada prestó su consentimiento para celebrar un contrato de compraventa definitivo, conforme se convino en el contrato preparatorio, en la que asumieron tal obligación, por lo que, de conformidad con el artículo 1529° del Código Civil, corresponde el perfeccionamiento del contrato de compra definitivo.",
    "palabras_clave": "Contrato preparatorio,debido proceso y motivación,Otorgamiento de escritura pública",
    "download_url": "/jurisprudenciaweb/ServletDescarga?uuid=a5d4f2cf-290c-4f04-ba0b-ebc7bedc439c"
  },
